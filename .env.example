# Copy to .env for local dev. Set these in Vercel → Environment Variables.
# Use your external Supabase project (jacbalsongvqvaqlfsbx).

SUPABASE_PROJECT_ID=jacbalsongvqvaqlfsbx
SUPABASE_URL=https://jacbalsongvqvaqlfsbx.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_anon_key_here

VITE_SUPABASE_PROJECT_ID=jacbalsongvqvaqlfsbx
VITE_SUPABASE_URL=https://jacbalsongvqvaqlfsbx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_key_here

# Comma-separated emails allowed to access /admin/curation (when admin auth is enabled)
VITE_ADMIN_EMAILS=you@example.com

# Contact form (Email me) — server-only. Set in Vercel Project → Environment Variables.
# Without RESEND_API_KEY the form falls back to the visitor's mail app (mailto).
RESEND_API_KEY=
CONTACT_TO_EMAIL=citizen.pulse101@gmail.com
# Verified sender in Resend (use onboarding@resend.dev only for tests)
CONTACT_FROM_EMAIL=Elenchos Contact <onboarding@resend.dev>

# Stripe Pro monthly packs (server-only). Test-mode Price IDs below.
# STRIPE_SECRET_KEY must be sk_test_… when using these test prices.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PACK_STARTER=price_1U62rN2EYDynfsPbGBfZED8c
STRIPE_PRICE_PACK_PLUS=price_1U62u62EYDynfsPbCXLtpn39
STRIPE_PRICE_PACK_MEGA=price_1U62vt2EYDynfsPbFsNiomxK
SITE_URL=https://elenchos.live